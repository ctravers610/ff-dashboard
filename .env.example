# Copy this file to .env and fill in your own values. .env is git-ignored.

# Comma-separated Sleeper usernames whose leagues should appear on the dashboard
SLEEPER_USERNAMES=your_username,your_other_username

# Comma-separated ESPN league ids (the leagueId=... number in the league URL)
ESPN_LEAGUE_IDS=
# Cookies from a logged-in ESPN browser session. Needed for private leagues and
# to know which team is yours. Treat these like a password.
ESPN_S2=
ESPN_SWID=

# Yahoo developer app (developer.yahoo.com/apps): Confidential Client,
# Fantasy Sports Read, redirect URI https://localhost:5173/api/auth/yahoo/callback
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=

# Encrypts the Yahoo tokens stored in the database. Required with Yahoo.
# 32 random bytes as base64; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing or changing it means connecting Yahoo again; nothing else is affected.
TOKEN_ENCRYPTION_KEY=

# Browser push for waiver reminders. Generate a pair once with:
#   npx web-push generate-vapid-keys
# Leave empty to turn reminders off. Changing them means turning reminders on again in each browser.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Sign in with GitHub. Leave these empty locally to run without sign-in; a
# production deployment refuses to start without them (or AUTH_DISABLED=1).
# OAuth app: github.com/settings/developers, callback <PUBLIC_URL>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated numeric GitHub user ids allowed in (https://api.github.com/users/<name>)
GITHUB_ALLOWED_USER_IDS=
# The address people open the site at (no trailing slash). Must be https in production.
# PUBLIC_URL=https://localhost:5173

# PostgreSQL. The default matches docker-compose.yml, so you only need this
# line if your database runs somewhere else.
# DATABASE_URL=postgres://ffd:ffd_dev_password@127.0.0.1:5432/ffd

# The analytics warehouse (analytics/, see the README). Optional: set it and
# History shows every past season of your Sleeper leagues. The loader writes
# here too; the app only reads (in production, give it a read-only role).
# ANALYTICS_DATABASE_URL=postgres://ffd:ffd_dev_password@127.0.0.1:5432/ffd_analytics

# Port the API server listens on (the web app proxies /api to it)
API_PORT=3001
