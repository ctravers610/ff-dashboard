# Copy this file to .env and fill in your own values. .env is git-ignored.

# Comma-separated Sleeper usernames whose leagues should appear on the dashboard
SLEEPER_USERNAMES=your_username,your_other_username

# Comma-separated ESPN league ids (the leagueId=... number in the league URL)
ESPN_LEAGUE_IDS=
# Cookies from a logged-in ESPN browser session. Needed for private leagues and
# to know which team is yours. Treat these like a password.
ESPN_S2=
ESPN_SWID=

# Yahoo developer app (developer.yahoo.com/apps): Confidential Client,
# Fantasy Sports Read, redirect URI https://localhost:5173/api/auth/yahoo/callback
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=

# PostgreSQL. The default matches docker-compose.yml, so you only need this
# line if your database runs somewhere else.
# DATABASE_URL=postgres://ffd:ffd_dev_password@127.0.0.1:5432/ffd

# Port the API server listens on (the web app proxies /api to it)
API_PORT=3001
